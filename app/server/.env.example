# ─── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
API_BASE_URL=http://localhost:3001

# ─── Frontend (for CORS) ──────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ─── Algolia (Player Search) ──────────────────────────────────────────────────
ALGOLIA_APP_ID=your-algolia-app-id
ALGOLIA_ADMIN_API_KEY=your-algolia-admin-key
ALGOLIA_SEARCH_API_KEY=your-algolia-search-key
ALGOLIA_PLAYERS_INDEX=footfrica_players

# ─── Upstash Redis (Caching) ──────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# ─── Cloudflare (Video) ───────────────────────────────────────────────────────
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
CLOUDFLARE_STREAM_CUSTOMER_SUBDOMAIN=your-stream-subdomain

# ─── Firebase (Push Notifications) ───────────────────────────────────────────
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-firebase-client-email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour-key\n-----END PRIVATE KEY-----\n"

# ─── Security ─────────────────────────────────────────────────────────────────
JWT_SECRET=your-supabase-jwt-secret
